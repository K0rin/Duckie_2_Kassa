<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.ManagerConsole.TabsControl.ReadyStateControl"
             xmlns:vm="clr-namespace:Duckie2Client.ViewModels"
             x:DataType="vm:TabItemViewModel">
    <Grid ColumnDefinitions="*"
          RowDefinitions="Auto,Auto"
          Name="UpdateMessageContainer">
        <TextBlock TextAlignment="Center"
                   Grid.Column="0"
                   Grid.Row="0"
                   xml:space="preserve">ready state
        </TextBlock>
        <Button Content="Обновить"
                HorizontalAlignment="Center"
                Grid.Column="0"
                Grid.Row="1"
                Command="{Binding UpdateDateCommand}" />

    </Grid>
</UserControl>