<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.Kassa.ClientPhoneNumber">
	<StackPanel Name="TransportScreenPanel"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center">
		<TextBlock Text="Please Enter Client's phone number" DockPanel.Dock="Top" HorizontalAlignment="Center"/>
		<TextBox
				 Margin="0,40,0,0"
				 DockPanel.Dock="Top"
        />
		<DockPanel DockPanel.Dock="Top" Margin="0,20,0,0">
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0, 10, 0, 0"
                        Content="Private"
						
                         />
			
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="110, 10, 0, 0"
                        Content="Empty"
						
                         />
		</DockPanel>
	</StackPanel>
</UserControl>
