<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.VehicleScreen"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		<TextBlock 
			Text="Please Enter Car Number" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center"
		/>
		<TextBox 
			Margin="0,40,0,0" 
			DockPanel.Dock="Top" 
			Name="VehicleNUmberTextBox" 
			Text="{Binding CarNumber}"
		/>
		<DockPanel DockPanel.Dock="Top">
			<Button 
				Name="PrivateButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0" 
				Command="{Binding ShowClientsConnectedWithVehicle}" 
				CommandParameter="private"
				IsEnabled="{Binding PrivateButtonEnabled}"
				PointerEntered="PrivateButtonCursorEntered"
				PointerExited="PrivateButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding PrivateButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding PrivateButtonTextColor}">Private</TextBlock>
				</DockPanel>
			</Button>
			<Button 
				Name="EmptyButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="10, 10, 0, 0"
				IsEnabled="{Binding EmptyButtonEnabled}"
				PointerEntered="EmptyButtonCursorEntered"
				PointerExited="EmptyButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding EmptyButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding EmptyButtonTextColor}">Empty</TextBlock>
				</DockPanel>
			</Button>
			<Button 
				Name="CompanyButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="8, 10, 0, 0" 
				Command="{Binding ShowClientsConnectedWithVehicle}" 
				CommandParameter="firm"
				IsEnabled="{Binding CompanyButtonEnabled}"
				PointerEntered="CompanyButtonCursorEntered"
				PointerExited="CompanyButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding CompanyButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding CompanyButtonTextColor}">Company</TextBlock>
				</DockPanel>
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
