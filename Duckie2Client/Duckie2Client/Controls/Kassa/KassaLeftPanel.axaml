<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.Kassa.KassaLeftPanel"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
>
	<StackPanel Background="#6a91a1" DockPanel.Dock="Left" >
		<Svg Path="/Assets/left_button_panel_logo.svg" Width="50" Height="50"/>
		<Button Command="{Binding ShowOrdersScreen}" Background="#6a91a1" Margin="0,30,0,0">
			<Svg Path="/Assets/orders.svg" Width="30" Height="30"/>
		</Button>
		<Button Command="{Binding ShowOrdersScreen}" Background="#6a91a1">
			<Svg Path="/Assets/calendar.svg" Width="30" Height="30"/>
		</Button>
		<Button Command="{Binding ShowWashesScreen}" Background="#6a91a1">
			<Svg Path="/Assets/washes.svg" Width="30" Height="30"/>
		</Button>
		<Button Command="{Binding CheckoutAndExit}" Background="#6a91a1">
			<Svg Path="/Assets/exit.svg" Width="30" Height="30"/>
		</Button>
	</StackPanel>
</UserControl>
