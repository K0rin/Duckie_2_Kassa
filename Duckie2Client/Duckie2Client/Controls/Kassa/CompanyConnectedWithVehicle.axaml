<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.Kassa.CompanyConnectedWithVehicle">
	<StackPanel Name="TransportScreenPanel"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center">
		<TextBlock Text="List Of Firms connected with Vehicle" DockPanel.Dock="Top" HorizontalAlignment="Center"/>
		<Grid Margin="0, 0, 0, 20">
			<!-- Определяем три столбца -->
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				
			</Grid.ColumnDefinitions>

			<!-- Определяем пять строк -->
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Пример ячеек таблицы -->
			<Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
				<TextBlock Text="Name" HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Border>
			<Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
				<TextBlock Text="MediaWay OU" HorizontalAlignment="Center" VerticalAlignment="Center" />
			</Border>
		</Grid>
		<DockPanel DockPanel.Dock="Top">
			<Button DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, 10, 0, 0" Content="Back"/>
			<Button DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 10, 0, 0" Content="Another Firm"/>
			<Button DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 10, 0, 0" Content="Next"/>
		</DockPanel>
	</StackPanel>
</UserControl>
