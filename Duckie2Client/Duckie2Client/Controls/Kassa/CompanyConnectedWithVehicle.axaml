<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"			 
             x:Class="Duckie2Client.Controls.Kassa.CompanyConnectedWithVehicle"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		<DockPanel HorizontalAlignment="Center">
			<TextBlock
			Text="Companies connected with "
			DockPanel.Dock="Left"
			HorizontalAlignment="Center"
			Margin="0, 0, 0, 20"
			/>
			<TextBlock Text="{Binding CarNumber}" DockPanel.Dock="Left"></TextBlock>
		</DockPanel>
		<DataGrid
			Margin="0,0,0,20"
			ItemsSource="{Binding CompanyVehicle}"
			AutoGenerateColumns="False"
			IsReadOnly="True"
			GridLinesVisibility="All"
			BorderThickness="1"
			BorderBrush="Gray"
			
		>
			<DataGrid.Columns>
				<DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}"/>
			</DataGrid.Columns>
		</DataGrid>
		<DockPanel DockPanel.Dock="Top">
			<Button 
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0" 
				Content="Back"
				Command="{Binding ShowClientsConnectedWithVehicle}" 
				CommandParameter="{Binding ClientType}"
			>
				<DockPanel>
					<Svg Path="/Assets/icon_back.svg" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="Black">Back</TextBlock>
				</DockPanel>
			</Button>
			<Button 
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="10, 10, 0, 0" 
				Content="Another Firm"
				Command="{Binding FindCompanyScreen}"
			>
				<DockPanel>
					<Svg Path="/Assets/icon_new_firm.svg" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="Black">Another Company</TextBlock>
				</DockPanel>
			</Button>
			<Button 
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="10, 10, 0, 0" 
				Command="{Binding ServicesListScreen}"
			>
				<DockPanel>
					<Svg Path="/Assets/icon_next.svg" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="Black">Next</TextBlock>
				</DockPanel>
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
