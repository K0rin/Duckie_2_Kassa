<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.Kassa.CompanyName">
	<StackPanel Name="TransportScreenPanel"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center">
		<TextBlock Text="Firm Name" DockPanel.Dock="Top" HorizontalAlignment="Center"/>
		<TextBox Margin="0,40,0,0" DockPanel.Dock="Top" Width="200"/>
		<DockPanel DockPanel.Dock="Top">
			<Button DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, 10, 0, 0" Content="Private"/>
			<Button DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="73, 10, 0, 0" Content="Search"/>
		</DockPanel>
	</StackPanel>
</UserControl>
