<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.FindCompanyName"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		<TextBlock 
			Text="Find Company" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center"
		/>
		<TextBox 
			Margin="0,40,0,0" 
			DockPanel.Dock="Top" 
			Width="230"
			Text="{Binding CompanyName}"
		/>
		<DockPanel DockPanel.Dock="Top">
			<Button 
				Name="CompanySearchBackButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0" 
				Command="{Binding OrderRoute}"
				PointerEntered="CompanySerachBackButtonCursorEntered"
				PointerExited="CompanySerachBackButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding CompanySearchBackButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding CompanySearchBackButtonTextColor}">Back</TextBlock>
				</DockPanel>
			</Button>
			<Button
				Name="CompanySearchButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="77, 10, 0, 0" 
				Command="{Binding FindCompany}"
				IsEnabled="{Binding CompanySearchButtonEnabled}"
				PointerEntered="CompanySearchButtonCursorEntered"
				PointerExited="CompanySearchButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding CompanySearchButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding CompanySearchButtonTextColor}">Search</TextBlock>
				</DockPanel>	
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
