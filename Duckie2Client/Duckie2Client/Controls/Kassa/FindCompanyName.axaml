<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.FindCompanyName"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		<TextBlock 
			Text="Find Company" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center"
		/>
		<TextBox 
			Margin="0,40,0,0" 
			DockPanel.Dock="Top" 
			Width="230"
			Text="{Binding CompanyName}"
		/>
		<DockPanel DockPanel.Dock="Top">
			<Button 
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0" 
				Command="{Binding OrderRoute}"
			>
				<DockPanel>
					<Svg Path="/Assets/icon_back.svg" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="Black">Back</TextBlock>
				</DockPanel>
			</Button>
			<Button 
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="77, 10, 0, 0" 
				Command="{Binding FindCompany}"
			>
				<DockPanel>
					<Svg Path="/Assets/icon_search.svg" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="Black">Search</TextBlock>
				</DockPanel>	
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
