<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.Kassa.TransportScreen"
			 >
	<StackPanel Name="TransportScreenPanel"
			 HorizontalAlignment="Center"
			 VerticalAlignment="Center">
		<TextBlock Text="Please Enter Car Number" DockPanel.Dock="Top" HorizontalAlignment="Center"/>
		<TextBox
				 Margin="0,40,0,0"
				 DockPanel.Dock="Top"
        />
		<DockPanel DockPanel.Dock="Top">
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0, 10, 0, 0"
                        Content="Private"
						
                         />
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10, 10, 0, 0"
                        Content="Empty"
						
                         />
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="10, 10, 0, 0"
                        Content="Empty"
						
                         />
		</DockPanel>
	</StackPanel>
</UserControl>
