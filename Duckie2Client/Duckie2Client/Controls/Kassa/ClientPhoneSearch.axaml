<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.ClientPhoneSearch"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		<TextBlock 
			Text="Please Enter Clients Phone Number" 
			DockPanel.Dock="Top" HorizontalAlignment="Center"
		/>
		<TextBox 
			Margin="0,40,0,0" 
			DockPanel.Dock="Top"
			Text="{Binding ClientPhone}"
		/>
		<DockPanel DockPanel.Dock="Top">
			<Button
				Name="ClientPhoneSearchBackButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0" 
				Command="{Binding ShowOrdersScreen}"
				PointerEntered="ClientPhoneSerachBackButtonCursorEntered"
				PointerExited="ClientPhoneSerachBackButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding ClientPhoneSearchBackButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding ClientPhoneSearchBackButtonTextColor}">Back</TextBlock>
				</DockPanel>
			</Button>
			<Button 
				Name="ClientPhoneSearchButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="120, 10, 0, 0"
				Command="{Binding SearchClientPhone}"
				IsEnabled="{Binding ClientPhoneSearchButtonEnabled}"
				PointerEntered="ClientPhoneSerachButtonCursorEntered"
				PointerExited="ClientPhoneSerachButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding ClientPhoneSearchButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding ClientPhoneSearchButtonTextColor}">Search</TextBlock>
				</DockPanel>			
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
