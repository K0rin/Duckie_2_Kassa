<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.NewClient"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
			 >
	<StackPanel Name="TransportScreenPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
		<DockPanel HorizontalAlignment="Center">
			<TextBlock Text="New client:" DockPanel.Dock="Left" />
			<TextBlock Text="{Binding ClientPhone}" DockPanel.Dock="Left"/>
		</DockPanel>
		<TextBlock 
			Text="FirstName" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center" 
			Margin="0, 10, 0, 0"
		/>
		<TextBox 
			Margin="0,0,0,0" 
			DockPanel.Dock="Top" 
			Width="240"
			Text="{Binding NewClientFirstName}"
		/>
		<TextBlock 
			Text="Lastname" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center" 
			Margin="0, 10, 0, 0"
		/>
		<TextBox 
			Margin="0,0,0,0" 
			DockPanel.Dock="Top" 
			Width="240"
			Text="{Binding NewClientLastName}"
		/>
		<TextBlock 
			Text="Email" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center" 
			Margin="0, 10, 0, 0"
		/>
		<TextBox 
			Margin="0,0,0,0" 
			DockPanel.Dock="Top" 
			Width="240"
			Text="{Binding NewClientEmail}"
		/>
		<TextBlock 
			Text="Notes about client" 
			DockPanel.Dock="Top" 
			HorizontalAlignment="Center" 
			Margin="0, 10, 0, 0"
		/>
		<TextBox 
			Margin="0,0,0,0" 
			DockPanel.Dock="Top" 
			Width="240" Height="90"
			Text="{Binding NewClientNotes}"
		/>
		<DockPanel DockPanel.Dock="Top" Width="240">

			<Button
				Name="BackButton"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0"
				Command="{Binding ShowClientsConnectedWithVehicle}" 
				CommandParameter="{Binding ClientType}"
				PointerEntered="NewClientBackButtonCursorEntered"
				PointerExited="NewClientBackButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding SaveNewClientBackButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding SaveNewClientBackButtonTextColor}">Back</TextBlock>
				</DockPanel>
			</Button>
			<Button
				Name="SaveNewClient"
				DockPanel.Dock="Left" 
				HorizontalAlignment="Left" 
				VerticalAlignment="Top" 
				Margin="98, 10, 0, 0"
				Command="{Binding SaveNewClient}"
				IsEnabled="{Binding SaveNewClientButtonEnabled}"
				PointerEntered="SaveNewClientButtonCursorEntered"
				PointerExited="SaveNewClientButtonCursorExited"
			>
				<DockPanel>
					<svg:Svg Path="{Binding SaveNewClientButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding SaveNewClientButtonTextColor}">Save</TextBlock>
				</DockPanel>
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
