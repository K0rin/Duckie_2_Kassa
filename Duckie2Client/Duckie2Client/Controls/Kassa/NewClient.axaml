<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Controls.Kassa.NewClient">
	<StackPanel Name="TransportScreenPanel"
			   HorizontalAlignment="Center"
			   VerticalAlignment="Center">
		<TextBlock Text="New client: 6573549" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0, 10, 0, 10"/>
		<TextBlock Text="FirstName" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0, 10, 0, 0"/>
		<TextBox
				 Margin="0,0,0,0"
				 DockPanel.Dock="Top"
				 Width="240"
        />
		<TextBlock Text="Lastname" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0, 10, 0, 0"/>
		<TextBox
				 Margin="0,0,0,0"
				 DockPanel.Dock="Top"
				 Width="240"
        />
		<TextBlock Text="Email" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0, 10, 0, 0"/>
		<TextBox
				 Margin="0,0,0,0"
				 DockPanel.Dock="Top"
				 Width="240"
        />
		<TextBlock Text="Notes about client" DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0, 10, 0, 0"/>
		<TextBox
				 Margin="0,0,0,0"
				 DockPanel.Dock="Top"
				 Width="240"
				 Height="90"
        />
		<DockPanel DockPanel.Dock="Top">
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0, 10, 0, 0"
                        Content="Back"
						
                         />
			
			<Button DockPanel.Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="140, 10, 0, 0"
                        Content="Save"
						
                         />
		</DockPanel>
	</StackPanel>
</UserControl>
