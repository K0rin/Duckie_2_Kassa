<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.CalendarScreen"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		
		<CalendarDatePicker />
		<Button
				Name="NextButton"
				DockPanel.Dock="Left"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Margin="10, 10, 0, 0"
				Content="Next"
				Command="{Binding OrderRoute}"
			>
			<DockPanel>
				<TextBlock>Find</TextBlock>
			</DockPanel>
		</Button>
	</StackPanel>
</UserControl>
