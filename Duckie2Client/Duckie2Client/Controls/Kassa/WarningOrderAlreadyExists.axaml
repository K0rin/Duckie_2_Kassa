<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             x:Class="Duckie2Client.Controls.Kassa.WarningOrderAlreadyExists"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
>
	<StackPanel 
		Name="TransportScreenPanel" 
		HorizontalAlignment="Center" 
		VerticalAlignment="Center"
	>
		<svg:Svg Path="/Assets/warning_icon.svg" Width="200" Height="200" Margin="0,0,5,0"/>
		<TextBlock 
			HorizontalAlignment="Center" 
			FontWeight="Bold" 
			FontSize="30"
		>
			Warning
		</TextBlock>
		<DockPanel HorizontalAlignment="Center">
			<TextBlock Text="Order for " FontSize="20"></TextBlock>
			<TextBlock 
				Text="{Binding CarNumber}" 
				FontSize="20" 
				FontWeight="Bold"
			></TextBlock>
			<TextBlock 
				Text=" is already confirmed" 
				FontSize="20"
			></TextBlock>
		</DockPanel>
		
		<DockPanel DockPanel.Dock="Top">
			<Button 
				Name="PrivateButton"
				DockPanel.Dock="Left"
				VerticalAlignment="Top" 
				Margin="0, 10, 0, 0"
				IsEnabled="True"
				Command="{Binding ShowOrdersScreen}" 
				PointerEntered="PrivateButtonCursorEntered"
				PointerExited="PrivateButtonCursorExited"
				HorizontalAlignment="Center"
			>
				<DockPanel>
					<svg:Svg Path="{Binding PrivateButtonIconPath}" Width="15" Height="15" Margin="0,0,5,0"/>
					<TextBlock Foreground="{Binding PrivateButtonTextColor}">OK</TextBlock>
				</DockPanel>
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
