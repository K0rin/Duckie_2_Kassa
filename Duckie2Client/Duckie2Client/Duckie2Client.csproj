    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Remove="FodyWeavers.xml" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\ConfigFileDeafultContext.resx">
