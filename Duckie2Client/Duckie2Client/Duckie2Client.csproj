        </Compile>
        <Compile Update="Views\Screens\AuthorizationScreenView.axaml.cs">
            <DependentUpon>AuthorizationScreenView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Screens\Kassa\CurrentPageView.axaml.cs">
          <SubType>Code</SubType>
          <DependentUpon>CurrentPageView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Screens\Kassa\KassaLeftPanel.axaml.cs">
          <DependentUpon>%(Filename)</DependentUpon>
        </Compile>
        <Compile Update="Views\Screens\Kassa\InnerTransactionPanel.axaml.cs">
          <DependentUpon>InnerTransactionPanel.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\Screens\Kassa\OrderCheckoutPanel.axaml.cs">
