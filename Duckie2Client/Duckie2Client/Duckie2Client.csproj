        <Folder Include="Migrations\" />
        <Folder Include="Packages\" />
        <Folder Include="Screens\" />
        <Folder Include="ViewModels\Controls\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Controls\Kassa\ShoppingCart.axaml.cs">
          <DependentUpon>ShoppingCart.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\Kassa\GoodsListScreen.axaml.cs">
          <SubType>Code</SubType>
          <DependentUpon>GoodsListScreen.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\Kassa\ServicesListScreen.axaml.cs">
          <SubType>Code</SubType>
          <DependentUpon>ServicesListScreen.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\Kassa\ListOfServices.axaml.cs">
