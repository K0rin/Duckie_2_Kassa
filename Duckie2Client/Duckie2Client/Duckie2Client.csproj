        </EmbeddedResource>
        <EmbeddedResource Update="Resources\UserInterface.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>UserInterface.Designer.cs</LastGenOutput>
            <LogicalName>Duckie2Client.Resources.UserInterface.resources</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\UserInterface.en.resx">
            <DependentUpon>UserInterface.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\UserInterface.en-us.resx">
            <DependentUpon>UserInterface.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\UserInterface.ru.resx">
            <DependentUpon>UserInterface.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\UserInterface.ru-ru.resx">
            <DependentUpon>UserInterface.resx</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>


    <ItemGroup>
        <Reference Include="DialogHost.Avalonia">
            <HintPath>Packages\DialogHost.Avalonia.dll</HintPath>
        </Reference>
        <Reference Include="System.Xaml" />
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\DataFaker\DataFaker.csproj" />
    </ItemGroup>


    <ItemGroup>
      <AvaloniaXaml Update="Controls\Kassa\GoodsListScreen.axaml">
