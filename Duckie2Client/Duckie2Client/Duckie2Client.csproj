        </Compile>
        <Compile Update="Views\Dialogs\SpinnerDialog.axaml.cs">
            <DependentUpon>SpinnerDialog.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Controls\Console\StartupControl.axaml.cs">
            <DependentUpon>Startup.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Screens\ManagerConsole\ClientCardBatchAddScreenView.axaml.cs">
            <DependentUpon>ClientCardBatchAddScreenScreenView.axaml</DependentUpon>
        </Compile>
        <Compile Update="App.axaml.declarations.cs">
            <DependentUpon>App.axaml</DependentUpon>
