<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:duckie2Client="clr-namespace:Duckie2Client"
             xmlns:duckieControls="clr-namespace:Duckie2Client.Controls.Kassa"
             xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
             xmlns:managerConsole="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Avalonia.Svg"
             x:Class="Duckie2Client.Views.Screens.MainKassaScreenView"
             x:CompileBindings="True"
             d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
             x:DataType="screens:MainKassaScreenViewModel"
			 mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
			 xmlns:views="clr-namespace:Duckie2Client.Views.Kassa"
>

	<DockPanel Name="MainScreen" Background="#c0b7ad">
		<!-- Main Menu -->
		<views:KassaLeftPanel DockPanel.Dock="Left"/>
		<StackPanel Background="#c0b7ad" Orientation="Vertical">
			<StackPanel HorizontalAlignment="" Background="#434141" Orientation="Horizontal">
				<views:UserPanel DockPanel.Dock="Top" />
				<views:OrderPanel DockPanel.Dock="Top" />
			</StackPanel>
			<views:InnerTransactionPanel Height="725"/>
			
		</StackPanel>
		
	</DockPanel>
	
</UserControl>
