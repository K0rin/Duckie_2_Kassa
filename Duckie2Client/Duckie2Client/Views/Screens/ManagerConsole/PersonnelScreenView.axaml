<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:personnelScreen="clr-namespace:Duckie2Client.ViewModels.Screens.ManagerConsole.PersonnelScreen"
             x:Class="Duckie2Client.Views.Screens.ManagerConsole.PersonnelScreenView"
             x:DataType="personnelScreen:PersonnelScreenViewModel">
    <dialogHostAvalonia:DialogHost Identifier="PersonnelScreenDialogs"
                                   DialogMargin="0"
                                   dialogHostAvalonia:DialogHostStyle.CornerRadius="0"
                                   OverlayBackground="Black"
                                   Background="Chocolate">
        <Button Content="ADD USER"
                Command="{Binding AddUserCommand}" />
    </dialogHostAvalonia:DialogHost>
</UserControl>