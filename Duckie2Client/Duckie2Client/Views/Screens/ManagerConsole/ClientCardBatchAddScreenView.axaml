<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Views.Screens.ManagerConsole.ClientCardBatchAddScreenView"
             xmlns:clientCardBatchAddScreen="clr-namespace:Duckie2Client.ViewModels.Screens.ManagerConsole.ClientCardBatchAddScreen"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:converters="clr-namespace:Duckie2Client.Converters"
             x:DataType="clientCardBatchAddScreen:ClientCardBatchAddScreenViewModel">
    <UserControl.Resources>
        <converters:EnableByCollectionCountConverter x:Key="EnableByCollectionCountConverter" />
    </UserControl.Resources>

    <!-- 
    todo: refact: 
    Какой-то UserControl, который предоставляет функционал диалога. 
    "Обертка" диалоговым окном повторяется. 
    -->
    <dialogHostAvalonia:DialogHost Identifier="ClientCardBatchAddScreenDialogs"
                                   DialogMargin="0"
                                   dialogHostAvalonia:DialogHostStyle.CornerRadius="0"
                                   OverlayBackground="Black"
                                   Background="Chocolate">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              HorizontalAlignment="Center"
              Margin="0 24 0 24"
              Name="DataContainer">

            <!-- Client block -->

            <Border Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="8 0 8 0"
                    Background="Black"
                    Width="2" />
            <TextBlock Text="Клиент"
                       FontWeight="Bold"
                       Margin="0 0 0 24"
                       Grid.Column="1"
                       Grid.Row="0" />
            <Grid ColumnDefinitions="Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto"
                  Grid.Column="1"
                  Grid.Row="1">
                <TextBlock Text="Имя:"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="0" />
                <TextBox Name="ClientFirstNameTextBox"
                         MinWidth="200"
                         MaxWidth="200"
                         TabIndex="0"
                         Text="{Binding ClientFirstNameValue, Mode=OneWayToSource}"
                         Grid.Column="1"
                         Grid.Row="0" />
                <TextBlock Text="Фамилия:"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="1" />
                <TextBox Name="ClientLastNameTextBox"
                         MinWidth="200"
                         MaxWidth="200"
                         TabIndex="1"
                         Text="{Binding ClientLastNameValue, Mode=OneWayToSource}"
                         Grid.Column="1"
                         Grid.Row="1" />
                <TextBlock Text="Телефон:"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="2" />
                <TextBox Name="ClientPhoneTextBox"
                         MinWidth="200"
                         MaxWidth="200"
                         TabIndex="2"
                         Text="{Binding ClientPhoneValue, Mode=OneWayToSource}"
                         Grid.Column="1"
                         Grid.Row="2" />
            </Grid>

            <!-- Company block -->

            <Border Grid.Column="2"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="8 0 8 0"
                    Background="Black"
                    Width="2" />
            <TextBlock Text="Фирма"
                       FontWeight="Bold"
                       Margin="0 0 0 24"
                       Grid.Column="3"
                       Grid.Row="0" />
            <Grid ColumnDefinitions="Auto"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  Grid.Column="3"
                  Grid.Row="1">
                <TextBlock Text="Зарегистрированные:"
                           Grid.Column="0"
                           Grid.Row="0" />
                <AutoCompleteBox Name="ClientFirmName"
                                 MaxDropDownHeight="300"
                                 MinWidth="300"
                                 MaxWidth="300"
                                 TabIndex="3"
                                 FilterMode="StartsWith"
                                 ItemsSource="{Binding DataPayload}"
                                 Text="{Binding CompanyNameValue, Mode=OneWayToSource}"
                                 Grid.Column="0"
                                 Grid.Row="1" />
                <TextBlock Text="Новая фирма:"
                           Grid.Column="0"
                           Grid.Row="2" />
                <TextBox Name="ClientNewFirmNameTextBox"
                         Watermark="Наименование новой фирмы"
                         MinWidth="300"
                         MaxWidth="300"
                         TabIndex="4"
                         Text="{Binding NewCompanyNameValue, Mode=OneWayToSource}"
                         Grid.Column="0"
                         Grid.Row="3" />
            </Grid>

            <!-- Vehicle block -->

            <Border Grid.Column="4"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="8 0 8 0"
                    Background="Black"
                    Width="2" />
            <TextBlock Text="Транспорт"
                       FontWeight="Bold"
                       Margin="0 0 0 24"
                       Grid.Column="5"
                       Grid.Row="0" />
            <Grid ColumnDefinitions="Auto,Auto"
                  RowDefinitions="Auto,Auto,Auto"
                  Grid.Column="5"
                  Grid.Row="1">
                <TextBlock Text="Номер:"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="0" />
                <TextBox Name="VehicleLicenceTextBox"
                         MinWidth="200"
                         MaxWidth="200"
                         TabIndex="5"
                         Text="{Binding VehicleLicenceValue, Mode=OneWayToSource}"
                         Grid.Column="1"
                         Grid.Row="0" />
                <TextBlock Text="Категория:"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="1" />
                <ComboBox Name="VehicleCategoryComboBox"
                          MaxDropDownHeight="100"
                          MinWidth="80"
                          MaxWidth="80"
                          TabIndex="6"
                          SelectedValue="{Binding VehiclePriceCategoryValue, Mode=OneWayToSource}"
                          Grid.Column="1"
                          Grid.Row="1">
                    <ComboBoxItem>A</ComboBoxItem>
                    <ComboBoxItem>B</ComboBoxItem>
                    <ComboBoxItem>C</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Скидка:"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Grid.Row="2" />
                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Grid.Row="2">
                    <TextBox Name="VehicleDiscount"
                             MinWidth="80"
                             MaxWidth="80"
                             TabIndex="7"
                             Text="{Binding VehicleDiscountValue, Mode=OneWayToSource}"
                             TextAlignment="End"
                             KeyDown="VehicleDiscount_OnKeyDown" />
                    <TextBlock Text="%"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- End line -->

            <Border Grid.Column="6"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="8 0 8 0"
                    Background="Black"
                    Width="2" />

            <Button Name="AddButton"
                    Grid.Column="0"
                    Grid.Row="2"
                    Grid.ColumnSpan="7"
                    HorizontalAlignment="Center"
                    Margin="0 24 0 12"
                    Content="Add List"
                    TabIndex="8"
                    Command="{Binding AddNewClientCommand}" />

            <!-- List of new clients -->

            <DataGrid ItemsSource="{Binding ClientsToAdd}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="False"
                      BorderThickness="1"
                      BorderBrush="Gray"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Grid.Column="0"
                      Grid.Row="3"
                      Grid.ColumnSpan="7"
                      MinHeight="341"
                      MaxHeight="341"
                      MaxWidth="1008">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header=""
                                            Binding="{Binding IsSelected}" />
                    <DataGridTextColumn Header="First Name"
                                        IsReadOnly="True"
                                        Binding="{Binding ClientFirstName.Result}" />
                    <DataGridTextColumn Header="Last Name"
                                        IsReadOnly="True"
                                        Binding="{Binding ClientLastName.Result}" />
                    <DataGridTextColumn Header="Phone"
                                        IsReadOnly="True"
                                        Binding="{Binding ClientPhone}" />
                    <DataGridTextColumn Header="Company Name"
                                        IsReadOnly="True"
                                        Binding="{Binding CompanyName.Result}" />
                    <DataGridTextColumn Header="Vehicle Licence"
                                        IsReadOnly="True"
                                        Binding="{Binding VehicleLicence}" />
                    <DataGridTextColumn Header="Price Category"
                                        IsReadOnly="True"
                                        Binding="{Binding VehiclePriceCategory}" />
                    <DataGridTextColumn Header="Discount"
                                        IsReadOnly="True"
                                        Binding="{Binding VehicleDiscount}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Statistics -->
            <!-- todo: Stat update -->
            <TextBlock Text="Total records: 999"
                       TextAlignment="Right"
                       Margin="0 12 0 12"
                       Grid.Column="0"
                       Grid.Row="4"
                       Grid.ColumnSpan="7" />

            <!-- Bottom Buttons -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="5"
                        Grid.ColumnSpan="7">

                <!-- Clear List Button -->

                <Button Name="ClearListButton"
                        Content="Clear List"
                        Command="{Binding ClearListCommand}"
                        IsEnabled="{Binding ClientsToAdd,
                        Converter={StaticResource EnableByCollectionCountConverter }}" />

                <!-- Add to the database button -->

                <Button Name="AddDatabaseButton"
                        TabIndex="9"
                        Content="Add Database"
                        Command="{Binding AddDatabaseCommand}"
                        IsEnabled="{Binding ClientsToAdd,
                        Converter={StaticResource EnableByCollectionCountConverter }}" />
            </StackPanel>
        </Grid>
    </dialogHostAvalonia:DialogHost>
</UserControl>