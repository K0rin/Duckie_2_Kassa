<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Views.Kassa.OrderPanel"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
>
	<StackPanel Orientation="Horizontal" Height="50">
		<Button DockPanel.Dock="Left" Content="ORDER1" />
		<Button DockPanel.Dock="Left" Content="ORDER2" />
		<Button DockPanel.Dock="Left" >
			<Image Source="avares://Duckie2Client/Assets/addIcon.png" Width="15" Height="15"/>
		</Button>
	</StackPanel>
</UserControl>
