<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Views.Kassa.OrderPanel"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia">
	<StackPanel Orientation="Horizontal" Height="50">
		<TextBlock
			VerticalAlignment="Center"
			Margin="5,0,5,0"
			Foreground="Gray">
			Orders:
		</TextBlock>
		<ContentControl Content="{Binding DockaPanelOrderButtons}"></ContentControl>
		<Button DockPanel.Dock="Left"
				Height="35"
				Width="30">
			<svg:Svg Path="/Assets/ribbon_add.svg" Width="35" Height="35" Margin="5,0,5,0"/>
		</Button>
	</StackPanel>
</UserControl>
