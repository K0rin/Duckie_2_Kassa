<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Duckie2Client.Views.Kassa.OrderCheckoutPanel1"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:KassaControls="clr-namespace:Duckie2Client.Controls.Kassa"
			 xmlns:screens="clr-namespace:Duckie2Client.ViewModels.Screens"
			 d:DataContext="{x:True duckie2Client:App.VM_MainKassaScreen}"
			 x:DataType="screens:MainKassaScreenViewModel"
			 xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
>
	<StackPanel HorizontalAlignment="Right" Background="#6a91a1" IsVisible="{Binding ClientPanelVisibility}">
		<ContentControl Content="{Binding ClientInfo}"></ContentControl>
		<DockPanel>
			<StackPanel>
				<ComboBox
					SelectedIndex="{Binding SelectedPriceTypeIndex, Mode=TwoWay}"
					Background="#6a91a1"
					>
					<ComboBoxItem Background="#6a91a1" Margin="0,-5,0,0">
						<Panel>
							<Svg Path="/Assets/icon_price_i.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
					<ComboBoxItem Background="#6a91a1">
						<Panel>
							<Svg Path="/Assets/icon_price_ii.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
					<ComboBoxItem Background="#6a91a1" Margin="0,0,0,-5">
						<Panel>
							<Svg Path="/Assets/icon_price_iii.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
				</ComboBox>

				
				<Button
					Name="BonusButton"
					DockPanel.Dock="Left"
					Content="Bonus"
					Width="95"
					Height="80"
					Background="#6a91a1"
					Margin="0,10,0,0"
					IsEnabled="{Binding BonusButtonEnabled}"
					PointerEntered="ClientBonusButtonCursorEntered"
					PointerExited="ClientBonusButtonCursorExited"
				>
					
					<svg:Svg Path="{Binding BonusButtonIconPath}" Width="50" Height="50"/>					
				</Button>

				<Button
					DockPanel.Dock="Left"
					Width="95"
					Height="60"
					Background="#6a91a1"
					Margin="0,10,0,0"
					Command="{Binding AddItemToShoppingCart}"
				>
					<Svg Path="/Assets/additional_service.svg" Width="50" Height="50"/>
				</Button>
			</StackPanel>
			<StackPanel>
				<ComboBox SelectedIndex="{Binding SelectedPollutionTypeIndex, Mode=TwoWay}" Background="#6a91a1">
					<ComboBoxItem Background="#6a91a1" Margin="0,-5,0,0">
						<Panel>
							<Svg Path="/Assets/icon_pollution_normal.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
					<ComboBoxItem Background="#6a91a1">
						<Panel>
							<Svg Path="/Assets/icon_pollution_middle.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
					<ComboBoxItem Background="#6a91a1" Margin="0,0,0,-5">
						<Panel>
							<Svg Path="/Assets/icon_pollution_high.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
				</ComboBox>
			</StackPanel>
			<StackPanel>
				<ComboBox  
					Background="#6a91a1"
					SelectedIndex="{Binding SelectedPaymentTypeIndex, Mode=TwoWay}">
					<ComboBoxItem Background="#6a91a1" Margin="0,-5,0,0">
						<Panel>
							<Svg Path="/Assets/icon_payment_type_cash.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
					<ComboBoxItem Background="#6a91a1">
						<Panel>
							<Svg Path="/Assets/icon_payment_type_card.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
					<ComboBoxItem Background="#6a91a1" Margin="0,0,0,-5">
						<Panel>
							<Svg Path="/Assets/icon_payment_type_debt.svg" Width="50" Height="50"/>
						</Panel>
					</ComboBoxItem>
				</ComboBox>

				<Button
					DockPanel.Dock="Left"
					Content="ClientCard"
					Width="80"
					Height="80"
					Background="#6a91a1"
					Margin="0,10,0,0"
				>
					<Canvas Background="Red">
						<Image Width="45" Height="45" Canvas.Top="10" Canvas.Left="8">
							<svg:SvgImage Source="/Assets/client_card.svg"/>
						</Image>
						<TextBlock Text="99" Canvas.Top="20" Canvas.Left="18" FontSize="18" FontWeight="Bold"></TextBlock>
					</Canvas>
				</Button>

				<Button
					DockPanel.Dock="Left"
					Width="95"
					Height="60"
					Background="#6a91a1"
					Margin="0,10,0,0"
							>
					<Svg Path="/Assets/icon_print_receipt_disabled.svg" Width="50" Height="50"/>
				</Button>
			</StackPanel>
		</DockPanel>
		<DockPanel>
			<Button
					DockPanel.Dock="Left"
					Width="85"
					Height="60"
					Background="#6a91a1"
					Margin="0,10,0,0"
							>
				<svg:Svg Path="/Assets/icon_clear_shopping_cart.svg" Width="50" Height="50"/>
			</Button>
			<Button
					DockPanel.Dock="Left"
					Width="85"
					Height="60"
					Background="#6a91a1"
					Margin="0,10,0,0"
							>
				<svg:Svg Path="/Assets/icon_cancel.svg" Width="50" Height="50"/>
			</Button>
			<Button
					DockPanel.Dock="Left"
					Width="85"
					Height="60"
					Background="#6a91a1"
					Margin="0,10,0,0"
					Command="{Binding SaveOrder}"
					IsEnabled="{Binding SaveOrderButtonEnabled}"
							>
				<svg:Svg Path="/Assets/success_icon.svg" Width="50" Height="50"/>
			</Button>
		</DockPanel>
	</StackPanel>
</UserControl>
