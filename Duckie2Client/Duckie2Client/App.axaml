<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Duckie2Client.App"
    x:CompileBindings="True"
    xmlns:local="using:Duckie2Client"
    RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" 
    are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- 
        Fonts 
        -->
        <FontFamily x:Key="FontRubikBold">
            avares://Duckie2Client/Assets/Fonts/Rubik-Bold.ttf#Rubik
        </FontFamily>
        <FontFamily x:Key="FontRubikRegular">
            avares://Duckie2Client/Assets/Fonts/Rubik-Regular.ttf#Rubik
        </FontFamily>
    </Application.Resources>

</Application>